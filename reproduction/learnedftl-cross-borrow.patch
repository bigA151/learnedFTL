+             cg_reason_no_open, cg_reason_no_room, cg_reason_trained,
+             cg_reason_busy, cg_reason_selected, cg_gate_with_candidate);
+    cg_donor_snapshot(ssd);
+    cg_relation_check(ssd, "after-fio");
+    femu_log("CG_SEQ_MODEL_INIT count=%" PRIu64 "\n", cg_seq_model_inits);
+    femu_log("PHYS_ID_SUMMARY writes=%" PRIu64 " copies=%" PRIu64 " reads=%" PRIu64 "\n", phys_audit_writes, phys_audit_copies, phys_audit_reads);
+    femu_log("MODEL_BITMAP_AUDIT attempts=%" PRIu64 " exact=%" PRIu64 " wrong=%" PRIu64 "\n", model_bitmap_attempt, model_bitmap_exact, model_bitmap_wrong);
+    femu_log("GC_DIAG calls=%" PRIu64 " wp=%" PRIu64
