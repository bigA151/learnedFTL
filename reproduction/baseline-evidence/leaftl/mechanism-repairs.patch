+static uint64_t bounded_segment_prediction(simple_segment *sg,
+                                            uint64_t off_lpn,
+                                            learned_mgmt *lm)
+{
+    double predicted = (double)sg->k * off_lpn + sg->inter;
+    if (!isfinite(predicted) || predicted < 0 ||
+        predicted >= lm->sp->page_total_cnt)
+        return INVALID_VAL;
+    return (uint64_t)predicted;
 }
 
